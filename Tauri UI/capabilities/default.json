{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "default",
  "description": "Default capabilities for AoE4 Strategyzer",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "fs:default",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-read-dir",
    "fs:allow-remove",
    "fs:allow-rename",
    "fs:allow-copy-file",
    "dialog:default",
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "$RESOURCE/**"
        },
        {
          "path": "$APPDATA/**"
        },
        {
          "path": "$APP/**"
        },
        {
          "path": "**"
        }
      ]
    }
  ]
}
