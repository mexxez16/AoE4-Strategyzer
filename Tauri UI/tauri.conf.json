{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AoE4 Strategyzer",
  "version": "0.1.1",
  "identifier": "com.aoe4.strategyzer",
  "build": {
    "frontendDist": "frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Age of Empires 4 Strategyzer",
        "width": 1920,
        "height": 1080,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "minWidth": 1200,
        "minHeight": 700,
        "devtools": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": ["German", "English", "French", "Spanish"],
        "displayLanguageSelector": true
      }
    },
    "shortDescription": "Strategy helper for Age of Empires 4",
    "longDescription": "AoE4 Strategyzer helps you manage build orders, tierlists, and matchup information for Age of Empires 4.",
    "publisher": "AoE4 Strategyzer"
  }
}
